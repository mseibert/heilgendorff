# Resend API Key für E-Mail-Versand
# Registriere dich bei https://resend.com und erstelle einen API Key
RESEND_API_KEY=re_xxxxxxxxxx

# Cloudflare Turnstile (Spam-Schutz Bewerbungsformular)
# Kostenloses Konto unter https://dash.cloudflare.com/?to=/:account/turnstile
# PUBLIC_ Präfix ist erforderlich, damit Astro den Wert im Client-Code verfügbar macht
# Werte 1:1 aus dem Cloudflare-Dashboard kopieren — kein Unterstrich, keine Leerzeichen.
# Site Key: 24 Zeichen (<Ziffer>x + 22), Secret Key: 35 Zeichen.
PUBLIC_TURNSTILE_SITE_KEY=0xAAAAAAAAAAAAAAAAAAAAAA
TURNSTILE_SECRET_KEY=0xAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# WICHTIG: Diese Datei NICHT committen!
# Kopiere sie zu .env und fülle die echten Werte ein.
# Die Umgebungsvariable muss auch in Vercel unter Project Settings > Environment Variables gesetzt werden.
